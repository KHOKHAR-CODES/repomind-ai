# Repomind AI — Root Production Environment Template
# Use this for Railway Variables OR docker-compose env_file.
# Never commit real secrets.

# App
APP_NAME=RepoMind AI
ENVIRONMENT=production

# PostgreSQL (Railway provides DATABASE_URL; for local use below)
DATABASE_URL=postgresql://repomind:repomind@db:5432/repomind

# JWT (generate: openssl rand -base64 48)
JWT_SECRET_KEY=<GENERATE_32_BYTE_SECRET>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Embedding / LLM
EMBEDDING_MODEL=all-MiniLM-L6-v2
LLM_API_KEY=<YOUR_OPENROUTER_KEY>
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=gpt-3.5-turbo
CHROMA_DB_PATH=./backend/data/chroma_db
REPOS_PATH=./backend/data/repos

# CORS / Frontend
FRONTEND_ORIGIN=https://repomind-frontend.railway.app
CORS_ALLOW_ORIGINS=https://repomind-frontend.railway.app
