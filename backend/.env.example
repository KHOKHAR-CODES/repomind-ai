APP_NAME=RepoMind AI
ENVIRONMENT=development
DATABASE_URL=sqlite:///./repomind.db
# Generate a unique secret (at least 32 random bytes) for each deployment.
# Production startup refuses an empty or short value.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_DB_PATH=./data/chroma_db
REPOS_PATH=./data/repos
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
FRONTEND_ORIGIN=http://localhost:5173
# Additional comma-separated exact origins, if required; do not use '*'.
CORS_ALLOW_ORIGINS=
