# Repomind AI — Production Environment Variables (Railway / One-Click Deploy)
# Copy this file and fill in secrets before deploying.
# Do NOT commit .env.production with real secrets; use Railway Variables instead.

APP_NAME=RepoMind AI
ENVIRONMENT=production

# PostgreSQL (Railway provides DATABASE_URL automatically)
DATABASE_URL=postgresql://user:password@host:port/db

# JWT Security (generate a 32-byte+ secret: openssl rand -base64 48)
JWT_SECRET_KEY=<GENERATE_32_BYTE_SECRET>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Embedding / LLM
EMBEDDING_MODEL=all-MiniLM-L6-v2
LLM_API_KEY=<YOUR_OPENROUTER_API_KEY>
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=gpt-3.5-turbo

# Paths
CHROMA_DB_PATH=./data/chroma_db
REPOS_PATH=./data/repos

# Frontend / CORS
FRONTEND_ORIGIN=https://repomind-frontend.railway.app
CORS_ALLOW_ORIGINS=https://repomind-frontend.railway.app
